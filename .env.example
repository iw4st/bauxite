# ── Database (Supabase PostgreSQL) ──────────────────────────────
# Find this in Supabase → Project Settings → Database → Connection string (URI)
# Use the "Transaction" pooler URI (port 6543) for serverless / Koyeb deployments.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection is needed for migrations only (port 5432).
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ── Auth ────────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-long-random-string-min-32-chars"

# ── CORS ────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (your frontend URLs).
CORS_ORIGIN="http://localhost:3000,https://your-app.vercel.app"

# ── Server ──────────────────────────────────────────────────────
# Koyeb injects PORT automatically; this is a fallback for local dev.
PORT=4000

# ── ICE Servers (WebRTC) ────────────────────────────────────────
# JSON array of RTCIceServer objects.
# Default uses free Google STUN. Add Metered.ca TURN credentials for production.
STUN_TURN_CONFIG='[{"urls":"stun:stun.l.google.com:19302"},{"urls":"stun:stun1.l.google.com:19302"},{"urls":"turn:your-turn-server.metered.ca:443","username":"your-username","credential":"your-credential"}]'
